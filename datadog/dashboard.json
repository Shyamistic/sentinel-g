{
  "title": "SENTINEL-G: LLM Reliability Control Plane",
  "description": "Real-time tracking of AI Hallucinations, Latency, and Financial Risk.",
  "widgets": [
    {
      "definition": {
        "title": "💰 Revenue at Risk (Real-Time)",
        "type": "query_value",
        "requests": [
          {
            "q": "sum:sentinel.business.risk{service:sentinel-g-api}.as_count()",
            "aggregator": "sum"
          }
        ],
        "autoscale": true,
        "precision": 0,
        "custom_unit": "$"
      }
    },
    {
      "definition": {
        "title": "📉 AI Confidence Score Stream",
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:sentinel.ai.confidence{service:sentinel-g-api} by {model}",
            "display_type": "line",
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            }
          }
        ],
        "yaxis": {
          "min": 0,
          "max": 1
        },
        "markers": [
          {
            "value": "y = 0.7",
            "display_type": "error dashed",
            "label": "Failure Threshold"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "🔴 Active Incidents Stream",
        "type": "log_stream",
        "indexes": [
          "*"
        ],
        "query": "service:sentinel-g-api status:error",
        "columns": [
          "timestamp",
          "failure_type",
          "risk_usd",
          "model"
        ],
        "show_date_column": false,
        "message_display": "expanded-md"
      }
    },
    {
      "definition": {
        "title": "✅ Recovery Actions Executed",
        "type": "query_value",
        "requests": [
          {
            "q": "count_default:sentinel.business.risk{status:recovered}.as_count()",
            "aggregator": "sum"
          }
        ],
        "autoscale": true,
        "custom_unit": "Fixes"
      }
    }
  ],
  "layout_type": "ordered"
}